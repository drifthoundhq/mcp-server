{
  "name": "@drifthoundhq/mcp-server",
  "version": "1.0.1",
  "description": "MCP server for DriftHound IaC drift detection and remediation",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "lint": "eslint src/**/*.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "drifthound",
    "terraform",
    "terragrunt",
    "iac",
    "drift-detection",
    "infrastructure-as-code",
    "claude"
  ],
  "author": "DriftHound HQ",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drifthoundhq/mcp-server.git"
  },
  "homepage": "https://github.com/drifthoundhq/mcp-server#readme",
  "bugs": {
    "url": "https://github.com/drifthoundhq/mcp-server/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
